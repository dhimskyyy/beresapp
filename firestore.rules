rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isTukangVerified() {
      return signedIn()
        && exists(/databases/$(database)/documents/tukang/$(request.auth.uid))
        && get(/databases/$(database)/documents/tukang/$(request.auth.uid)).data.verificationStatus == 'verified'
        && get(/databases/$(database)/documents/tukang/$(request.auth.uid)).data.isSuspended == false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /tukang/{tukangId} {
      allow read: if signedIn() && (request.auth.uid == tukangId || isAdmin());
      allow create: if signedIn() && request.auth.uid == tukangId
        && request.resource.data.verificationStatus == 'pending_verification'
        && request.resource.data.isSuspended == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == tukangId
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.isSuspended == resource.data.isSuspended
        && request.resource.data.walletBalance == resource.data.walletBalance);
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.selectedTukangId == request.auth.uid
        || (resource.data.status in ['OPEN', 'BIDDING'] && isTukangVerified())
      );
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || (resource.data.selectedTukangId == request.auth.uid && isTukangVerified())
        || (resource.data.status in ['OPEN', 'BIDDING'] && isTukangVerified())
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      match /chats/{messageId} {
        allow read, write: if signedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/tickets/$(ticketId)).data.selectedTukangId == request.auth.uid
        );
      }
    }

    match /withdrawals/{withdrawalId} {
      allow read: if signedIn() && (
        isAdmin() || resource.data.tukangId == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.tukangId == request.auth.uid
        && isTukangVerified()
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
  }
}
