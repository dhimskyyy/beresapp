rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isTukangVerified() {
      return signedIn()
        && exists(/databases/$(database)/documents/tukang/$(request.auth.uid))
        && get(/databases/$(database)/documents/tukang/$(request.auth.uid)).data.verificationStatus == 'verified'
        && get(/databases/$(database)/documents/tukang/$(request.auth.uid)).data.isSuspended == false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    match /tukang/{tukangId} {
      // User dapat membaca profil tukang untuk melihat reputasi & data bidding
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == tukangId
        && request.resource.data.verificationStatus == 'pending_verification'
        && request.resource.data.isSuspended == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == tukangId
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.isSuspended == resource.data.isSuspended
        && request.resource.data.id == resource.data.id);
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.selectedTukangId == request.auth.uid
        || (resource.data.status in ['OPEN', 'BIDDING'] && isTukangVerified())
      );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'OPEN';
      allow update: if signedIn() && (
        isAdmin()
        || (resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (request.resource.data.status == resource.data.status)
            || (resource.data.status in ['OPEN', 'BIDDING'] && request.resource.data.status == 'LOCKED' && request.resource.data.selectedTukangId != null)
            || (resource.data.status in ['OPEN', 'BIDDING', 'LOCKED'] && request.resource.data.status == 'CANCELED')
            || (resource.data.status == 'PAYMENT_PENDING' && request.resource.data.status == 'COMPLETED' && request.resource.data.paymentMethod == 'CASH' && request.resource.data.paymentStatus == 'paid')
          ))
        || (resource.data.selectedTukangId == request.auth.uid
          && isTukangVerified()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.selectedTukangId == resource.data.selectedTukangId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (resource.data.status == 'LOCKED' && request.resource.data.status == 'ON_THE_WAY')
            || (resource.data.status == 'ON_THE_WAY' && request.resource.data.status == 'ARRIVED')
            || (resource.data.status == 'ARRIVED' && request.resource.data.status == 'IN_PROGRESS')
            || (resource.data.status == 'IN_PROGRESS' && request.resource.data.status == 'WORK_COMPLETED')
            || (resource.data.status == 'WORK_COMPLETED' && request.resource.data.status == 'PAYMENT_PENDING')
            || (resource.data.status == 'PAYMENT_PENDING' && request.resource.data.status == 'COMPLETED' && request.resource.data.paymentMethod == 'CASH' && request.resource.data.paymentStatus == 'paid')
            || (request.resource.data.status == resource.data.status)
          ))
        || (resource.data.status in ['OPEN', 'BIDDING']
          && isTukangVerified()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status == 'BIDDING')
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status in ['OPEN', 'BIDDING', 'CANCELED']);

      match /chats/{messageId} {
        allow read: if signedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/tickets/$(ticketId)).data.selectedTukangId == request.auth.uid
        );
        allow create: if signedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/tickets/$(ticketId)).data.selectedTukangId == request.auth.uid
        ) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if isAdmin();
    }

    match /walletTransactions/{transactionId} {
      allow read, write: if isAdmin();
    }
  }
}
